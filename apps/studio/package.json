{
  "name": "@loom/studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_MOCK=1 vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:e2e": "playwright test -c playwright.config.ts",
    "test:e2e:local": "playwright test -c playwright.mock.config.ts",
    "check:copy": "node scripts/check-pure-zh.mjs",
    "verify:engine": "node scripts/verify-engine.mjs --out evidence/engine-verify.json",
    "build:e2e": "VITE_E2E=1 vite build",
    "build:mock": "VITE_MOCK=1 VITE_E2E=1 vite build"
  },
  "dependencies": {
    "monaco-editor": "0.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  }
}
