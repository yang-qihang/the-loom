{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Loomcraft",
  "version": "0.1.0",
  "identifier": "dev.loomcraft.desktop",
  "build": {
    "beforeDevCommand": "node scripts/build-assets.mjs",
    "beforeBuildCommand": "node scripts/build-assets.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "织界",
        "width": 1440,
        "height": 900,
        "minWidth": 420,
        "minHeight": 620,
        "center": true,
        "decorations": false,
        "resizable": true,
        "visible": false,
        "devtools": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "resources": [
      "runtime/"
    ],
    "category": "Education",
    "shortDescription": "织界 —— 在窗口里写符文，驱动织偶在世界里干活",
    "longDescription": "织界是《我的世界》编程教育游戏的桌面版：在窗口里写符文，驱动织偶在村庄里干活。",
    "linux": {
      "deb": {
        "depends": []
      },
      "rpm": {
        "depends": []
      }
    }
  }
}